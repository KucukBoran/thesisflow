{
  "name": "kucukboran/thesisflow",
  "description": "A role-based thesis review workflow built with PHP and PDO.",
  "type": "project",
  "license": "MIT",
  "require": {
    "php": ">=8.3",
    "ext-pdo": "*",
    "ext-pdo_sqlite": "*",
    "ext-fileinfo": "*",
